{% comment %}
  Ghar Essentials icon set. Drawn in-house to the brand book: 24px grid, 2px
  stroke, round caps and joins, no fill. They inherit currentColor, so an icon
  takes the colour of whatever it sits in rather than carrying its own.

  Inline SVG on purpose - no icon library, nothing extra fetched, nothing to
  slow the page down on mobile data.

  Accepts:
  - icon: {String} name from the list below. Required.
  - size: {String} width and height, e.g. '24'. Default 24. (optional)
  - stroke: {String} stroke width. Default 2. Use 2.4 where an icon needs to
      hold its own against a bold wordmark, as in the header. (optional)
  - class: {String} extra classes on the svg. (optional)

  Usage: {% render 'ghar-icon', icon: 'leaf' %}
{% endcomment %}

{%- liquid
  assign icon_size = size | default: 24
  assign icon_stroke = stroke | default: 2
-%}

<svg
  class="ghar-icon ghar-icon--{{ icon }}{% if class %} {{ class }}{% endif %}"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="{{ icon_stroke }}"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case icon -%}
    {%- when 'leaf' -%}
      <path d="M4 20c0-8 5.5-14.5 16-16 .5 11-5.5 16-13 16H4Z"/>
      <path d="M4 20c3.5-4.5 7.5-7.5 12.5-9.5"/>

    {%- when 'shield' -%}
      <path d="M12 3 19 6v5.5c0 4.6-3 8.3-7 9.5-4-1.2-7-4.9-7-9.5V6l7-3Z"/>
      <path d="m9 12 2 2 4-4"/>

    {%- when 'cash' -%}
      <rect x="2.5" y="6" width="19" height="12" rx="2"/>
      <circle cx="12" cy="12" r="2.5"/>
      <path d="M6 10v4M18 10v4"/>

    {%- when 'truck' -%}
      <path d="M2.5 7h11v9h-11z"/>
      <path d="M13.5 10.5h3.8l3.2 3.2V16h-7z"/>
      <circle cx="7" cy="18" r="1.8"/>
      <circle cx="17" cy="18" r="1.8"/>

    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="9"/>
      <path d="M12 7v5.2l3.2 1.9"/>

    {%- when 'drop' -%}
      <path d="M12 3s6.2 6.6 6.2 10.4A6.2 6.2 0 1 1 5.8 13.4C5.8 9.6 12 3 12 3Z"/>

    {%- when 'spray' -%}
      <path d="M11 8h5v13H7.5V11A3 3 0 0 1 11 8Z"/>
      <path d="M11 8V4.5h4"/>
      <path d="M17.5 5.5h2.5M17.5 8.5h2.5M19 2.5h1.5"/>

    {%- when 'bottle' -%}
      <path d="M10 2.5h4v3l2 3.2V19a2.5 2.5 0 0 1-2.5 2.5h-3A2.5 2.5 0 0 1 8 19V8.7L10 5.5Z"/>
      <path d="M8 13h8"/>

    {%- when 'sparkle' -%}
      <path d="M12 3.5 13.8 9l5.5 1.8-5.5 1.8L12 18l-1.8-5.4L4.7 10.8 10.2 9 12 3.5Z"/>
      <path d="M18.5 16.5 19.2 19l2.3.8-2.3.8-.7 2.4"/>

    {%- when 'search' -%}
      <circle cx="11" cy="11" r="7"/>
      <path d="m20 20-3.8-3.8"/>

    {%- when 'user' -%}
      <circle cx="12" cy="8" r="4"/>
      <path d="M4.5 20.5a7.5 7.5 0 0 1 15 0"/>

    {%- when 'bag' -%}
      <path d="M5.5 8h13l-1 12.5h-11L5.5 8Z"/>
      <path d="M9 8V6a3 3 0 0 1 6 0v2"/>

    {%- when 'menu' -%}
      <path d="M3.5 7h17M3.5 12h17M3.5 17h17"/>

    {%- when 'close' -%}
      <path d="m6 6 12 12M18 6 6 18"/>

    {%- when 'chevron' -%}
      <path d="m6 9 6 6 6-6"/>
  {%- endcase -%}
</svg>
