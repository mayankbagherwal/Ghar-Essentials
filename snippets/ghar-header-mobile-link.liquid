{% comment %}
  One row in the mobile drawer. Parents expand in place with details/summary.

  Accepts: link
{% endcomment %}
<li class="ghar-header__drawer-item">
  {%- if link.links.size > 0 -%}
    <details class="ghar-header__drawer-group">
      <summary class="ghar-header__drawer-summary">
        <span>{{ link.title | escape }}</span>
        <span class="ghar-header__caret" aria-hidden="true">{%- render 'ghar-icon', icon: 'chevron' -%}</span>
      </summary>
      <ul class="ghar-header__drawer-sublist" role="list">
        {%- for child in link.links -%}
          <li>
            <a class="ghar-header__drawer-sublink" href="{{ child.url }}">{{ child.title | escape }}</a>
          </li>
        {%- endfor -%}
      </ul>
    </details>
  {%- else -%}
    <a
      class="ghar-header__drawer-link{% if link.current %} is-current{% endif %}"
      href="{{ link.url }}"
      {% if link.current %}
        aria-current="page"
      {% endif %}
    >
      {{- link.title | escape -}}
    </a>
  {%- endif -%}
</li>
