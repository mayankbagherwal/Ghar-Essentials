{{ 'ghar-glow.css' | asset_url | stylesheet_tag }}
{{ 'section-frequently-bought-together.css' | asset_url | stylesheet_tag }}
{% render 'ghar-money' %}
<script src="{{ 'ghar-money.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'section-frequently-bought-together.js' | asset_url }}" defer="defer"></script>

{%- liquid
  # This product first when asked for, then whatever the owner picked. A
  # product that is out of stock is dropped rather than shown as a tickable
  # line the shopper cannot actually buy.
  assign scheme = section.settings.color_scheme | default: 'scheme-1'
-%}

<div class="color-{{ scheme }} gradient">
  <div
    class="fbt page-width section-{{ section.id }}-padding"
    style="--fbt-accent: {{ section.settings.accent_color }}; --fbt-accent-text: {{ section.settings.accent_text_color }};"
  >
    {%- comment -%}
      Everything below is rendered by Liquid at its starting state and then kept
      in step by the custom element as boxes are ticked. Nothing is invented in
      the browser: every price here is a real variant price, and the totals are
      those same numbers added up.
    {%- endcomment -%}
    <ghar-bundle
      class="fbt__inner"
      data-button-label="{{ section.settings.button_label | escape }}"
      data-savings-text="{{ section.settings.savings_text | escape }}"
      data-empty-label="{{ section.settings.empty_label | escape }}"
      {% if section.settings.show_timer %}
        data-timer-minutes="{{ section.settings.timer_minutes }}"
        data-timer-key="ghar-fbt-{{ section.id }}"
        data-timer-end="{{ section.settings.timer_end }}"
        data-timer-on-end="{{ section.settings.timer_on_end }}"
      {% endif %}
    >
      {%- if section.settings.heading != blank -%}
        <h2 class="fbt__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <ul class="fbt__list" role="list">
        {%- comment -%} This product, so the set the shopper sees starts with what they came for {%- endcomment -%}
        {%- if section.settings.include_current and product != blank and product.available -%}
          {%- render 'fbt-card',
            card_product: product,
            is_current: true,
            current_label: section.settings.current_label
          -%}
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- if block.type == 'product' and block.settings.product != blank and block.settings.product.available -%}
            {%- render 'fbt-card',
              card_product: block.settings.product,
              block: block
            -%}
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {%- comment -%}
        Totals. The struck-through figure is the MRPs added up, so the saving is
        the difference between two real numbers rather than a percentage typed
        into a setting.
      {%- endcomment -%}
      <div class="fbt__totals">
        <p class="fbt__total">
          <span class="fbt__total-label">{{ section.settings.total_label | escape }}</span>
          <span class="fbt__total-value" data-fbt-total></span>
          <s class="fbt__total-was" data-fbt-was></s>
        </p>

        {%- if section.settings.show_timer -%}
          <p class="fbt__timer" data-fbt-timer hidden>
            <span class="fbt__timer-label">{{ section.settings.timer_label | escape }}</span>
            <span class="fbt__timer-clock" data-fbt-clock></span>
          </p>
        {%- endif -%}
      </div>

      <button
        type="button"
        class="fbt__button{% if section.settings.glow %} ghar-glow{% endif %}"
        data-fbt-add
      >
        <span data-fbt-button-text>{{ section.settings.button_label | escape }}</span>
        <span class="fbt__spinner" data-fbt-spinner hidden></span>
      </button>

      <p class="fbt__savings" data-fbt-savings></p>

      <p class="fbt__error" data-fbt-error role="alert" hidden></p>
    </ghar-bundle>
  </div>
</div>

{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Frequently bought together",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently bought together"
    },
    {
      "type": "checkbox",
      "id": "include_current",
      "label": "Start with the product being viewed",
      "info": "Keeps the set the shopper is looking at in front of them.",
      "default": true
    },
    {
      "type": "text",
      "id": "current_label",
      "label": "Label on the current product",
      "info": "Leave empty for none.",
      "default": "This item"
    },
    {
      "type": "header",
      "content": "Totals"
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "Total line label",
      "default": "Total price:"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "info": "Write {count} where the number of ticked products should go.",
      "default": "Add {count} to cart"
    },
    {
      "type": "text",
      "id": "empty_label",
      "label": "Button text when nothing is ticked",
      "default": "Select a product"
    },
    {
      "type": "text",
      "id": "savings_text",
      "label": "Line under the button",
      "info": "Use {count} for the number of products, {total} for the price and {saved} for the amount saved. Leave empty for none.",
      "default": "Get {count} products for {total} and save {saved}"
    },
    {
      "type": "header",
      "content": "Countdown"
    },
    {
      "type": "paragraph",
      "content": "A countdown on an offer that does not actually end is listed as false urgency in the CCPA Guidelines for Prevention and Regulation of Dark Patterns, 2023. Set a real end date below and the timer tells the truth."
    },
    {
      "type": "checkbox",
      "id": "show_timer",
      "label": "Show a countdown",
      "default": false
    },
    {
      "type": "text",
      "id": "timer_label",
      "label": "Countdown label",
      "default": "Deal ends in"
    },
    {
      "type": "text",
      "id": "timer_end",
      "label": "Deal ends at",
      "info": "A real date and time, e.g. 2026-09-30 23:59. Leave empty to count down the minutes below on each visit instead.",
      "default": ""
    },
    {
      "type": "range",
      "id": "timer_minutes",
      "min": 1,
      "max": 60,
      "step": 1,
      "unit": "min",
      "label": "Minutes to count down per visit",
      "info": "Only used when no end date is set above.",
      "default": 5
    },
    {
      "type": "select",
      "id": "timer_on_end",
      "label": "When the countdown reaches zero",
      "options": [
        { "value": "hide", "label": "Hide the countdown, keep the offer" },
        { "value": "restart", "label": "Start it again" }
      ],
      "info": "Starting it again is the pattern the guidelines above call out.",
      "default": "hide"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "glow",
      "label": "Make the button glow",
      "default": true
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Discount badge background",
      "default": "#f2c230"
    },
    {
      "type": "color",
      "id": "accent_text_color",
      "label": "Discount badge text",
      "default": "#12211b"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "checkbox",
          "id": "checked",
          "label": "Ticked to start with",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Frequently bought together",
      "blocks": [{ "type": "product" }]
    }
  ]
}
{% endschema %}
