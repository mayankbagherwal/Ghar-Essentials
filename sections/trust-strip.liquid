{{ 'section-trust-strip.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme | default: 'scheme-2' }} gradient">
  <div class="trust page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="trust__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="trust__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="trust__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%}
      Cards rather than a bare row of labels. On a phone they scroll sideways
      with the next one peeking, which signals there is more to see; on desktop
      they sit as an even grid.
    {%- endcomment -%}
    <ul class="trust__list trust__list--{{ section.settings.layout }}" role="list">
      {%- for block in section.blocks -%}
        <li class="trust__item" {{ block.shopify_attributes }}>
          <div class="trust__card">
            {%- if block.settings.icon != blank -%}
              <span class="trust__badge">
                {{
                  block.settings.icon
                  | image_url: width: 120
                  | image_tag: loading: 'lazy', widths: '48,72,96,120', sizes: '48px', class: 'trust__icon-image', alt: ''
                }}
              </span>
            {%- elsif block.settings.icon_name != 'none' -%}
              <span class="trust__badge">
                {%- render 'ghar-icon', icon: block.settings.icon_name, stroke: '2.2' -%}
              </span>
            {%- endif -%}

            <div class="trust__text">
              {%- if block.settings.label != blank -%}
                <p class="trust__label">{{ block.settings.label | escape }}</p>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="trust__description">{{ block.settings.description | escape }}</p>
              {%- endif -%}
            </div>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Trust strip",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Optional. Leave empty for a plain row of cards.",
      "default": "Why homes keep reordering"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Card layout",
      "options": [
        { "value": "cards", "label": "Cards with a description" },
        { "value": "compact", "label": "Compact, icon and label only" }
      ],
      "default": "cards"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "info": "Scheme 2 is the soft Leaf tint the brand book gives alternating bands.",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Trust point",
      "settings": [
        {
          "type": "select",
          "id": "icon_name",
          "label": "Icon",
          "info": "Drawn in the brand's own line style. Upload below only to replace it.",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "shield", "label": "Shield" },
            { "value": "cash", "label": "Cash" },
            { "value": "truck", "label": "Delivery van" },
            { "value": "clock", "label": "Clock" },
            { "value": "drop", "label": "Drop" },
            { "value": "spray", "label": "Spray bottle" },
            { "value": "bottle", "label": "Bottle" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "none", "label": "No icon" }
          ],
          "default": "leaf"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Custom icon (optional)",
          "info": "Square, about 120x120px, transparent background. Only needed if you want to replace the drawn icon."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Plant-based cleansers"
        },
        {
          "type": "text",
          "id": "description",
          "label": "One-line description",
          "info": "Shown in the Cards layout. Keep it to a single specific sentence.",
          "default": "Made with cleansers derived from coconut."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust strip",
      "blocks": [
        { "type": "item", "settings": { "icon_name": "leaf", "label": "Plant-based cleansers", "description": "Made with cleansers derived from coconut." } },
        { "type": "item", "settings": { "icon_name": "shield", "label": "Safe around food & kids", "description": "For everyday kitchen surfaces." } },
        { "type": "item", "settings": { "icon_name": "cash", "label": "Cash on delivery", "description": "Pay when it reaches your door." } },
        { "type": "item", "settings": { "icon_name": "truck", "label": "Delivers in 3-5 days", "description": "Shipped across India." } }
      ]
    }
  ]
}
{% endschema %}
