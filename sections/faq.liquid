{{ 'section-faq.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme | default: 'scheme-1' }} gradient">
  <div class="faq page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="faq__heading">{{ section.settings.heading | escape | newline_to_br }}</h2>
    {%- endif -%}

    <div class="faq__list">
      {%- for block in section.blocks -%}
        <details class="faq__item" {{ block.shopify_attributes }}>
          <summary class="faq__question">{{ block.settings.question | escape }}</summary>
          <div class="faq__answer rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>

    {%- if section.settings.contact_text != blank -%}
      <p class="faq__contact">
        {%- if section.settings.contact_link != blank -%}
          <a href="{{ section.settings.contact_link }}">{{ section.settings.contact_text | escape }}</a>
        {%- else -%}
          {{ section.settings.contact_text | escape }}
        {%- endif -%}
      </p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "section",
  "max_blocks": 20,
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Questions people ask us",
      "info": "Press Enter to break the line where you want it."
    },
    {
      "type": "text",
      "id": "contact_text",
      "label": "Line under the questions",
      "default": "Still unsure? Message us on WhatsApp."
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Link for that line",
      "info": "Paste your WhatsApp link, in the form https://wa.me/91XXXXXXXXXX"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Is it safe around children and food?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Write a short, specific answer here. [SUBSTANTIATE BEFORE LAUNCH]</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "Is it safe around children and food?",
            "answer": "<p>Our cleaners use plant-based cleansers and are made for everyday kitchen surfaces. Rinse food-contact surfaces with water after cleaning, and keep the bottle out of reach of children. [SUBSTANTIATE BEFORE LAUNCH]</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Do you offer cash on delivery?",
            "answer": "<p>Yes. Cash on delivery is available across India. You can also pay online and get an extra 5% off.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How long does delivery take?",
            "answer": "<p>Orders are usually delivered in 3 to 5 working days. [SUBSTANTIATE BEFORE LAUNCH]</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What if I don't like it?",
            "answer": "<p>Write your actual return policy here, matching your returns page word for word. [SUBSTANTIATE BEFORE LAUNCH]</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How do I use it?",
            "answer": "<p>Spray onto the surface, leave for 30 seconds, then wipe with a damp cloth. For heavy grease, repeat once.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Is the bottle recyclable?",
            "answer": "<p>Describe the actual bottle material and what a customer should do with it. Say what it is made of rather than calling it eco-friendly. [SUBSTANTIATE BEFORE LAUNCH]</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
