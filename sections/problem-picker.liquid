{{ 'section-problem-picker.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme | default: 'scheme-1' }} gradient">
  <div class="problem-picker page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="problem-picker__heading">{{ section.settings.heading | escape | newline_to_br }}</h2>
    {%- endif -%}

    <ul class="problem-picker__list" role="list">
      {%- for block in section.blocks -%}
        <li class="problem-picker__item" {{ block.shopify_attributes }}>
          <a
            class="problem-picker__tile"
            {% if block.settings.link != blank %}
              href="{{ block.settings.link }}"
            {% else %}
              href="{{ routes.all_products_collection_url }}"
            {% endif %}
          >
            <span class="problem-picker__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 400
                  | image_tag:
                    loading: 'lazy',
                    widths: '150,200,300,400',
                    sizes: '(min-width: 750px) 200px, 130px',
                    class: 'problem-picker__image',
                    alt: block.settings.label
                }}
              {%- else -%}
                <span class="problem-picker__placeholder" aria-hidden="true"></span>
              {%- endif -%}
            </span>
            <span class="problem-picker__label">{{ block.settings.label | escape }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Problem picker",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "What are you cleaning today?",
      "info": "Press Enter to break the line where you want it."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Square, about 400x400px. A close, well-lit photo of the actual mess this product solves - greasy stove top, stained bathroom tile, dusty floor. Real Indian kitchens and bathrooms, shot on a phone, work far better here than clean studio shots. The shopper should recognise their own house."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Kitchen grease"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Links to",
          "info": "Point at the product that solves it, not a collection, so it stays two taps to checkout."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Problem picker",
      "blocks": [
        {
          "type": "tile",
          "settings": {
            "label": "Kitchen grease"
          }
        },
        {
          "type": "tile",
          "settings": {
            "label": "Chimney & stove"
          }
        },
        {
          "type": "tile",
          "settings": {
            "label": "Bathroom & tiles"
          }
        },
        {
          "type": "tile",
          "settings": {
            "label": "Floors"
          }
        },
        {
          "type": "tile",
          "settings": {
            "label": "Hard-water stains"
          }
        }
      ]
    }
  ]
}
{% endschema %}
