<div class="zz-test"></div>
{% schema %}
{
  "name": "ZZ test schema",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently bought together"
    },
    {
      "type": "checkbox",
      "id": "include_current",
      "label": "Start with the product being viewed",
      "info": "Keeps the set the shopper is looking at in front of them.",
      "default": true
    },
    {
      "type": "text",
      "id": "current_label",
      "label": "Label on the current product",
      "info": "Leave empty for none.",
      "default": "This item"
    },
    {
      "type": "header",
      "content": "Totals"
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "Total line label",
      "default": "Total price:"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "info": "Write {count} where the number of ticked products should go.",
      "default": "Add {count} to cart"
    },
    {
      "type": "text",
      "id": "empty_label",
      "label": "Button text when nothing is ticked",
      "default": "Select a product"
    },
    {
      "type": "text",
      "id": "savings_text",
      "label": "Line under the button",
      "info": "Use {count} for the number of products, {total} for the price and {saved} for the amount saved. Leave empty for none.",
      "default": "Get {count} products for {total} and save {saved}"
    },
    {
      "type": "header",
      "content": "Countdown"
    },
    {
      "type": "paragraph",
      "content": "A countdown on an offer that does not actually end is listed as false urgency in the CCPA Guidelines for Prevention and Regulation of Dark Patterns, 2023. Set a real end date below and the timer tells the truth."
    },
    {
      "type": "checkbox",
      "id": "show_timer",
      "label": "Show a countdown",
      "default": false
    },
    {
      "type": "text",
      "id": "timer_label",
      "label": "Countdown label",
      "default": "Deal ends in"
    },
    {
      "type": "text",
      "id": "timer_end",
      "label": "Deal ends at",
      "info": "A real date and time, e.g. 2026-09-30 23:59. Leave empty to count down the minutes below on each visit instead.",
      "default": ""
    },
    {
      "type": "range",
      "id": "timer_minutes",
      "min": 1,
      "max": 60,
      "step": 1,
      "unit": "min",
      "label": "Minutes to count down per visit",
      "info": "Only used when no end date is set above.",
      "default": 5
    },
    {
      "type": "select",
      "id": "timer_on_end",
      "label": "When the countdown reaches zero",
      "options": [
        { "value": "hide", "label": "Hide the countdown, keep the offer" },
        { "value": "restart", "label": "Start it again" }
      ],
      "info": "Starting it again is the pattern the guidelines above call out.",
      "default": "hide"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "glow",
      "label": "Make the button glow",
      "default": true
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Discount badge background",
      "default": "#f2c230"
    },
    {
      "type": "color",
      "id": "accent_text_color",
      "label": "Discount badge text",
      "default": "#12211b"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "checkbox",
          "id": "checked",
          "label": "Ticked to start with",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ZZ test schema",
      "blocks": [{ "type": "product" }]
    }
  ]
}
{% endschema %}
