{{ 'section-header-ghar.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-header-ghar.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #GharHeader-{{ section.id }} {
    --ghar-header-height: {{ section.settings.header_height }}px;
    --ghar-header-height-mobile: {{ section.settings.header_height_mobile }}px;
    --ghar-logo-width: {{ section.settings.logo_width }}px;
    --ghar-logo-width-mobile: {{ section.settings.logo_width_mobile }}px;
    --ghar-logo-height: {{ section.settings.logo_height }}px;
    --ghar-logo-height-mobile: {{ section.settings.logo_height_mobile }}px;
    --ghar-logo-inset: {{ section.settings.logo_inset }}px;
    --ghar-header-gutter: {{ section.settings.header_gutter }}px;
    --ghar-header-gutter-mobile: {{ section.settings.header_gutter_mobile }}px;
  }
{%- endstyle -%}

{%- liquid
  assign menu_left = section.settings.menu_left
  assign menu_right = section.settings.menu_right
-%}

<ghar-header
  id="GharHeader-{{ section.id }}"
  class="ghar-header color-{{ section.settings.color_scheme | default: 'scheme-1' }} gradient{% if section.settings.sticky %} ghar-header--sticky{% endif %}"
>
  <div class="ghar-header__inner page-width">
    {%- comment -%} Left: menu toggle on mobile, search plus first menu on desktop {%- endcomment -%}
    <div class="ghar-header__side ghar-header__side--start">
      <details class="ghar-header__drawer" data-ghar-drawer>
        <summary class="ghar-header__icon-button ghar-header__burger" aria-label="{{ 'sections.header.menu' | t }}">
          <span class="ghar-header__icon" aria-hidden="true">{%- render 'ghar-icon', icon: 'menu', stroke: '2.4' -%}</span>
        </summary>

        <div class="ghar-header__drawer-panel">
          <nav class="ghar-header__drawer-nav" aria-label="{{ 'sections.header.menu' | t }}">
            <ul class="ghar-header__drawer-list" role="list">
              {%- for link in menu_left.links -%}
                {%- render 'ghar-header-mobile-link', link: link -%}
              {%- endfor -%}
              {%- for link in menu_right.links -%}
                {%- render 'ghar-header-mobile-link', link: link -%}
              {%- endfor -%}
            </ul>
          </nav>

          {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
            <a
              class="ghar-header__drawer-account"
              href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
            >
              {%- render 'ghar-icon', icon: 'user', size: '20' -%}
              <span>
                {%- if customer -%}
                  {{- 'customer.account.title' | t -}}
                {%- else -%}
                  {{- 'customer.log_in' | t -}}
                {%- endif -%}
              </span>
            </a>
          {%- endif -%}

          {%- if section.settings.drawer_note != blank -%}
            <p class="ghar-header__drawer-note">{{ section.settings.drawer_note | escape }}</p>
          {%- endif -%}
        </div>
      </details>

      {%- if section.settings.show_search -%}
        <button
          type="button"
          class="ghar-header__icon-button ghar-header__search-link"
          data-ghar-search-toggle
          aria-expanded="false"
          aria-label="{{ 'general.search.search' | t }}"
        >
          <span class="ghar-header__icon" aria-hidden="true">{%- render 'ghar-icon', icon: 'search', stroke: '2.4' -%}</span>
        </button>
      {%- endif -%}

      {%- if menu_left.links.size > 0 -%}
        <nav class="ghar-header__nav ghar-header__nav--left" aria-label="{{ 'sections.header.menu' | t }}">
          <ul class="ghar-header__list" role="list">
            {%- for link in menu_left.links -%}
              {%- render 'ghar-header-link', link: link, index: forloop.index, side: 'l', section_id: section.id -%}
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    </div>

    {%- comment -%} Centre: the logo lockup {%- endcomment -%}
    <div class="ghar-header__centre">
      {%- capture logo_markup -%}
        {%- if section.settings.logo != blank -%}
          {{
            section.settings.logo
            | image_url: width: 600
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '120,180,240,360,480,600',
              sizes: '(min-width: 990px) 320px, 200px',
              class: 'ghar-header__logo-image',
              alt: shop.name
          }}
        {%- else -%}
          {%- comment -%}
            Text lockup until the logo file is uploaded: lowercase wordmark over
            letterspaced ESSENTIALS, matching the mark in the brand book.
          {%- endcomment -%}
          <span class="ghar-header__wordmark">
            <span class="ghar-header__wordmark-name">{{ section.settings.wordmark | escape }}</span>
            <span class="ghar-header__wordmark-sub">{{ section.settings.wordmark_sub | escape }}</span>
          </span>
        {%- endif -%}
      {%- endcapture -%}

      {%- if request.page_type == 'index' -%}
        <h1 class="ghar-header__logo">
          <a href="{{ routes.root_url }}">{{ logo_markup }}</a>
        </h1>
      {%- else -%}
        <a class="ghar-header__logo" href="{{ routes.root_url }}">{{ logo_markup }}</a>
      {%- endif -%}
    </div>

    {%- comment -%} Right: second menu on desktop, account and cart everywhere {%- endcomment -%}
    <div class="ghar-header__side ghar-header__side--end">
      {%- if menu_right.links.size > 0 -%}
        <nav class="ghar-header__nav ghar-header__nav--right" aria-label="{{ 'sections.header.menu' | t }}">
          <ul class="ghar-header__list" role="list">
            {%- for link in menu_right.links -%}
              {%- render 'ghar-header-link', link: link, index: forloop.index, side: 'r', section_id: section.id -%}
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}

      {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
        <a
          class="ghar-header__icon-button ghar-header__account"
          href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
          aria-label="{%- if customer -%}{{ 'customer.account.title' | t }}{%- else -%}{{ 'customer.log_in' | t }}{%- endif -%}"
        >
          <span class="ghar-header__icon" aria-hidden="true">
            {%- render 'ghar-icon', icon: 'user', stroke: '2.4' -%}
          </span>
        </a>
      {%- endif -%}

      {%- if section.settings.show_search -%}
        <button
          type="button"
          class="ghar-header__icon-button ghar-header__search-mobile"
          data-ghar-search-toggle
          aria-expanded="false"
          aria-label="{{ 'general.search.search' | t }}"
        >
          <span class="ghar-header__icon" aria-hidden="true">{%- render 'ghar-icon', icon: 'search', stroke: '2.4' -%}</span>
        </button>
      {%- endif -%}

      <a
        class="ghar-header__icon-button ghar-header__cart"
        href="{{ routes.cart_url }}"
        aria-label="{{ 'templates.cart.cart' | t }}"
      >
        <span class="ghar-header__icon" aria-hidden="true">
          {%- render 'ghar-icon', icon: 'bag', stroke: '2.4' -%}
        </span>
        {%- if cart.item_count > 0 -%}
          <span class="ghar-header__cart-count" aria-hidden="true">{{ cart.item_count }}</span>
          <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>
  </div>

  {%- if section.settings.show_search -%}
    {%- comment -%}
      The search bar expands in place rather than sending anyone to another
      page. Recent searches are kept on the shopper's own device, never sent
      anywhere. Submitting falls through to Shopify's own search results.
    {%- endcomment -%}
    <div class="ghar-search" data-ghar-search hidden>
      <div class="ghar-search__inner page-width">
        <form class="ghar-search__form" action="{{ routes.search_url }}" method="get" role="search">
          <input type="hidden" name="options[prefix]" value="last">
          <span class="ghar-search__icon" aria-hidden="true">{%- render 'ghar-icon', icon: 'search', stroke: '2.4' -%}</span>
          <input
            class="ghar-search__input"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ section.settings.search_placeholder | escape }}"
            autocomplete="off"
            enterkeyhint="search"
            aria-label="{{ 'general.search.search' | t }}"
            data-ghar-search-input
          >
          <button type="submit" class="ghar-search__submit">{{ 'general.search.search' | t }}</button>
          <button
            type="button"
            class="ghar-search__close"
            data-ghar-search-close
            aria-label="{{ 'accessibility.close' | t }}"
          >
            <span aria-hidden="true">&times;</span>
          </button>
        </form>

        <div class="ghar-search__recent" data-ghar-recent hidden>
          <div class="ghar-search__recent-head">
            <span class="ghar-search__recent-title">{{ section.settings.recent_heading | escape }}</span>
            <button type="button" class="ghar-search__recent-clear" data-ghar-recent-clear>
              {{- section.settings.recent_clear | escape -}}
            </button>
          </div>
          <ul class="ghar-search__recent-list" data-ghar-recent-list role="list"></ul>
        </div>
      </div>
    </div>
  {%- endif -%}
</ghar-header>

{% schema %}
{
  "name": "Header (Ghar)",
  "class": "ghar-header-section",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "The green house-and-leaf mark with the wordmark beside it. PNG or SVG with a transparent background, at least 600px wide. Until one is uploaded the header falls back to a text version of the lockup."
    },
    {
      "type": "range",
      "id": "header_height",
      "min": 60,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Header height on desktop",
      "info": "A hard height, not a minimum. The bar is exactly this tall whatever the logo is set to.",
      "default": 80
    },
    {
      "type": "range",
      "id": "header_height_mobile",
      "min": 52,
      "max": 110,
      "step": 2,
      "unit": "px",
      "label": "Header height on mobile",
      "default": 64
    },
    {
      "type": "range",
      "id": "logo_inset",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Space above and below the logo",
      "info": "Breathing room inside the bar. The logo is never allowed to exceed the bar height minus this, so the header keeps the height you set no matter where the logo slider is.",
      "default": 8
    },
    {
      "type": "range",
      "id": "header_gutter",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Side padding on desktop",
      "default": 40
    },
    {
      "type": "range",
      "id": "header_gutter_mobile",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Side padding on mobile",
      "default": 20
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 24,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Logo height on desktop",
      "info": "This is the one that makes the logo bigger. It can exceed the bar height if you want the mark to sit proud of it.",
      "default": 56
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "min": 20,
      "max": 96,
      "step": 2,
      "unit": "px",
      "label": "Logo height on mobile",
      "default": 40
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 90,
      "max": 320,
      "step": 10,
      "unit": "px",
      "label": "Maximum logo width on desktop",
      "info": "Only a ceiling. Height below is what actually sizes the logo.",
      "default": 180
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "min": 80,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Maximum logo width on mobile",
      "default": 130
    },
    {
      "type": "text",
      "id": "wordmark",
      "label": "Fallback wordmark",
      "default": "ghar"
    },
    {
      "type": "text",
      "id": "wordmark_sub",
      "label": "Fallback wordmark second line",
      "default": "ESSENTIALS"
    },
    {
      "type": "header",
      "content": "Menus"
    },
    {
      "type": "link_list",
      "id": "menu_left",
      "label": "Menu left of the logo",
      "info": "Two or three links reads best. Any link with sub-links becomes a dropdown.",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "menu_right",
      "label": "Menu right of the logo",
      "info": "Two or three links. On mobile both menus appear together in the slide-out drawer."
    },
    {
      "type": "text",
      "id": "drawer_note",
      "label": "Note at the bottom of the mobile menu",
      "default": "Cash on delivery available across India"
    },
    {
      "type": "header",
      "content": "Icons"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search",
      "default": true
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search box placeholder",
      "default": "Search kitchen, bathroom, floor..."
    },
    {
      "type": "text",
      "id": "recent_heading",
      "label": "Recent searches heading",
      "default": "Recent searches"
    },
    {
      "type": "text",
      "id": "recent_clear",
      "label": "Clear recent searches text",
      "default": "Clear"
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account",
      "default": true
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Stick to the top when scrolling",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
